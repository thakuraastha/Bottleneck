BOTTLENECK_ENVIRONMENT=development
BOTTLENECK_DATABASE_URL=sqlite:///./bottleneck.db
BOTTLENECK_DATA_DIR=./data
BOTTLENECK_SIMULATION_DATE=2026-01-15
BOTTLENECK_PLANNING_HORIZON_DAYS=30
BOTTLENECK_MEDIUM_RISK_ALTERNATIVE_RESEARCH=true
BOTTLENECK_GEMINI_MODEL=gemini-flash-lite-latest
BOTTLENECK_GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
BOTTLENECK_MODEL_RETRY_ATTEMPTS=1
BOTTLENECK_MODEL_STAGE_TIMEOUT_SECONDS=75
BOTTLENECK_A2A_SUPPLIER_URL=http://127.0.0.1:8000/a2a
BOTTLENECK_A2A_REQUEST_TIMEOUT_SECONDS=120
BOTTLENECK_MODEL_INPUT_COST_PER_MILLION_USD=0.10
BOTTLENECK_MODEL_OUTPUT_COST_PER_MILLION_USD=0.40
BOTTLENECK_CLOUD_DEPLOYMENT_URL=https://bottleneck.vercel.app
GOOGLE_API_KEY=
GEMINI_API_KEY=
